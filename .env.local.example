# Supabase — copy values from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — Dashboard > Developers > API keys / Webhooks
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — ใช้ส่งอีเมลยืนยันคำสั่งซื้อ (ต้อง verify domain ก่อนถึงจะส่งออกได้จริง)
RESEND_API_KEY=re_...
ORDER_EMAIL_FROM=The Cardlist <orders@thecardlistbkk.com>

# LINE Messaging API — ใช้ push แจ้งเตือนลูกค้า (ยืนยันออเดอร์ / บัตรอนุมัติ)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# LINE Login — ใช้ผูกบัญชี LINE กับโปรไฟล์ลูกค้า
LINE_CLIENT_ID=your-line-login-channel-id
LINE_CLIENT_SECRET=your-line-login-channel-secret
LINE_REDIRECT_URI=https://thecardlistbkk.com/api/auth/line/callback

# URL ของเว็บไซต์จริง — ใช้สร้างลิงก์ callback (webhook เรียก /api/notify ผ่าน URL นี้)
NEXT_PUBLIC_SITE_URL=https://thecardlistbkk.com
